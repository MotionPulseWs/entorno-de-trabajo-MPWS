# ===== motionpulse.xyz — no indexar en buscadores =====
# Envía la cabecera X-Robots-Tag en TODAS las respuestas (HTML, PDF, imágenes).
# Si las carpetas de los subdominios están dentro de este public_html,
# también la heredan. Si un subdominio tiene su propio .htaccess
# (ej. WordPress), agrega este mismo bloque al inicio de ese archivo.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Caché de imágenes (el HTML no se cachea para ver cambios al instante)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

DirectoryIndex index.html
